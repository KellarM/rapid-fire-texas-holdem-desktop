{
  "name": "PlayerStats",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Device identifier to scope stats per device"
    },
    "player_slot": {
      "type": "number",
      "description": "Player slot index (0-based)"
    },
    "totalBets": {
      "type": "number",
      "default": 0
    },
    "totalWins": {
      "type": "number",
      "default": 0
    },
    "roundsPlayed": {
      "type": "number",
      "default": 0
    },
    "roundsWon": {
      "type": "number",
      "default": 0
    },
    "highestMultiplier": {
      "type": "number",
      "default": 0
    },
    "highestBalance": {
      "type": "number"
    },
    "highestBalanceRound": {
      "type": "number"
    },
    "lowestBalance": {
      "type": "number"
    },
    "lowestBalanceRound": {
      "type": "number"
    }
  },
  "required": [
    "device_id",
    "player_slot"
  ]
}